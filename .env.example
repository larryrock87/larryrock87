# Copie este archivo como .env (o defina estas variables en su servicio de hosting)

# Contraseña del panel del administrador (mínimo 8 caracteres en producción)
ADMIN_PASSWORD=cambie-esta-clave

# --- Supabase (opcional; sin estas dos variables se usa el disco local) ---
# Supabase → Project Settings → API (Data API) → Project URL
SUPABASE_URL=https://SU-PROYECTO.supabase.co
# Supabase → Project Settings → API Keys → service_role / secret key
# ¡SECRETA! Solo en el servidor. Nunca la publique ni la ponga en el navegador.
SUPABASE_SERVICE_ROLE_KEY=
# Opcionales
# SUPABASE_BUCKET=festival
# SUPABASE_MAX_FILE_MB=50
# PORT=3000
# NODE_ENV=production
